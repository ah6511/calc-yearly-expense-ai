# LLM Provider ("openai" | "claude" | "bedrock" | "gemini")
LLM_PROVIDER=claude
MAX_RETRIES=3
MAX_TOKENS=4096

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_ID=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o-mini

# AWS / Bedrock / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Google / Gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-4-neon
# Optional thinking level: MINIMAL | LOW | MEDIUM | HIGH | XHIGH
GEMINI_THINKING_LEVEL=

# TypeSafe AI (exclusion & category classification)
TYPESAFE_API_KEY=ts_...
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_MAX_CONCURRENCY=5

# Storage ("local" | "s3")
STORAGE_BACKEND=local
BUCKET_NAME=

# Execution Mode
SINGLE_FILE_MODE=false
SINGLE_FILE_MODE_PDF_NAME=20251125-statements-8506-.pdf
LOG_LEVEL=INFO

